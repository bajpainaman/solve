#!/usr/bin/env bash
# solve — CLI shim that launches Codex with $solve preloaded
#
# Usage:
#   solve                              open Codex and start interactive intake
#   solve "<one-line problem>"         start $solve with a problem
#   solve <path/to/brief.md>           start $solve with a brief path
#   solve --tier quick|standard|deep  preselect the analysis tier
#   solve --budget time=30min spend=5 set time/external-research caps
#   solve progress [--watch]          show the newest run's progress
#   solve calibrate <command>         inspect confidence calibration
#   solve --status                    show installation/runtime status
#   solve --update                    refresh the installed skill
#   solve --uninstall                 remove the Codex skill and shim

set -euo pipefail

CODEX_BIN="${CODEX_BIN:-codex}"
SKILL="${SOLVE_SKILL_ROOT:-$HOME/.agents/skills/solve}"
REMOTE_INSTALL="https://raw.githubusercontent.com/bajpainaman/solve/main/install"

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

resolve_path() {
  python3 - "$1" <<'PY'
import sys
from pathlib import Path

print(Path(sys.argv[1]).expanduser().resolve())
PY
}

require_codex() {
  if ! command -v "$CODEX_BIN" >/dev/null 2>&1; then
    echo "ERROR: Codex CLI not on PATH. Install it from https://developers.openai.com/codex/cli" >&2
    exit 1
  fi
}

require_skill() {
  if [ ! -f "$SKILL/SKILL.md" ]; then
    echo "ERROR: \$solve is not installed at $SKILL" >&2
    echo "Install: bash <(curl -fsSL $REMOTE_INSTALL)" >&2
    exit 1
  fi
}

case "${1:-}" in
  --help|-h|help)
    usage
    exit 0
    ;;
  update|up|--update|-u)
    require_codex
    SOURCE=""
    if [ -L "$SKILL" ]; then
      SOURCE=$(resolve_path "$SKILL")
    elif [ -d "$SKILL/.git" ]; then
      SOURCE="$SKILL"
    fi

    if [ -n "$SOURCE" ] && [ -x "$SOURCE/install" ] && [ -d "$SOURCE/.git" ]; then
      echo "Updating source at $SOURCE..."
      if git -C "$SOURCE" pull --ff-only; then
        exec bash "$SOURCE/install"
      fi
      echo "Local update failed; falling back to the upstream installer." >&2
    elif [ -n "$SOURCE" ] && [ -x "$SOURCE/install" ]; then
      exec bash "$SOURCE/install"
    fi

    echo "Running upstream installer..."
    exec bash <(curl -fsSL "$REMOTE_INSTALL")
    ;;
  uninstall|remove|--uninstall)
    set +e
    if [ -L "$SKILL" ]; then
      rm -f -- "$SKILL"
      echo "removed $SKILL symlink"
    elif [ -d "$SKILL" ]; then
      ARCHIVE="$SKILL.uninstalled.$(date +%Y%m%d-%H%M%S)"
      mv -- "$SKILL" "$ARCHIVE"
      echo "moved $SKILL to recoverable archive $ARCHIVE"
    fi

    SHIM="${SOLVE_SHIM_DIR:-$HOME/.local/bin}/solve"
    if [ -L "$SHIM" ] || [ -f "$SHIM" ]; then
      if [ -f "$SHIM" ] && grep -Fq '# solve — CLI shim that launches Codex with $solve preloaded' "$SHIM" 2>/dev/null; then
        rm -f -- "$SHIM"
        echo "removed $SHIM"
      else
        echo "left unrecognized launcher in place: $SHIM"
      fi
    fi

    for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
      if [ -f "$rc" ] && grep -q '# solve-cli >>>' "$rc" 2>/dev/null; then
        RC_BACKUP="$rc.solve-bak.$(date +%Y%m%d-%H%M%S)"
        cp -- "$rc" "$RC_BACKUP"
        python3 - "$rc" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path) as handle:
    text = handle.read()
text = re.sub(r"\n?# solve-cli >>>.*?# solve-cli <<<\n?", "\n", text, flags=re.DOTALL)
with open(path, "w") as handle:
    handle.write(text)
PY
        echo "cleaned $rc (backup at $RC_BACKUP)"
      fi
    done
    echo "Uninstalled Codex integration. Parallel.ai data and any legacy Claude installation were left intact."
    exit 0
    ;;
  progress|--progress)
    require_skill
    if [ ! -x "$SKILL/bin/progress" ]; then
      echo "ERROR: progress helper missing at $SKILL/bin/progress" >&2
      exit 1
    fi
    LATEST_RUN=$(python3 - .context/solve <<'PY' 2>/dev/null || true
import sys
from pathlib import Path

root = Path(sys.argv[1])
directories = [path for path in root.iterdir() if path.is_dir()] if root.is_dir() else []
if directories:
    print(max(directories, key=lambda path: path.stat().st_mtime_ns))
PY
)
    if [ -z "$LATEST_RUN" ]; then
      echo "no solve runs found in .context/solve/" >&2
      exit 1
    fi
    shift
    exec "$SKILL/bin/progress" --run-dir "$LATEST_RUN" "$@"
    ;;
  calibrate|--calibrate)
    require_skill
    if [ ! -x "$SKILL/bin/calibration" ]; then
      echo "ERROR: calibration helper missing at $SKILL/bin/calibration" >&2
      exit 1
    fi
    shift
    exec "$SKILL/bin/calibration" "$@"
    ;;
  status|--status|version|--version|-V)
    require_codex
    require_skill
    SKILL_VER=$(tr -d '[:space:]' < "$SKILL/VERSION" 2>/dev/null || true)
    echo "solve CLI shim:   $0"
    echo "skill location:   $SKILL"
    if [ -L "$SKILL" ]; then echo "skill source:     $(resolve_path "$SKILL")"; fi
    echo "skill version:    ${SKILL_VER:-unknown}"
    echo "codex version:    $("$CODEX_BIN" --version 2>/dev/null | head -1)"
    if "$CODEX_BIN" features list 2>/dev/null | awk '$1 == "multi_agent" && $NF == "true" { found=1 } END { exit !found }'; then
      echo "subagents:        enabled"
    else
      echo "subagents:        unavailable or disabled"
    fi
    if [ -n "${PARALLEL_API_KEY:-}" ] || [ -s "$HOME/.gstack/parallel-api-key" ]; then
      echo "parallel.ai key:  configured"
    else
      echo "parallel.ai key:  not configured (optional: $SKILL/bin/parallel-setup)"
    fi
    exit 0
    ;;
esac

require_codex
require_skill
export SOLVE_SKILL_ROOT="$SKILL"

# These environment variables let the skill skip the matching intake prompts.
PRESEED_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tier)
      [ $# -ge 2 ] || { echo "ERROR: --tier requires quick|standard|deep" >&2; exit 2; }
      case "$2" in
        quick|standard|deep) export SOLVE_PRESEED_TIER="$2"; shift 2 ;;
        *) echo "ERROR: --tier must be quick|standard|deep" >&2; exit 2 ;;
      esac
      ;;
    --budget)
      shift
      while [ $# -gt 0 ] && [[ "$1" =~ ^(time|spend|tokens)= ]]; do
        case "$1" in
          time=*)
            RAW_TIME=${1#time=}
            case "$RAW_TIME" in
              unlimited|null) export SOLVE_PRESEED_TIME=null ;;
              *min)
                TIME_NUMBER=${RAW_TIME%min}
                [[ "$TIME_NUMBER" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: invalid time budget: $RAW_TIME" >&2; exit 2; }
                export SOLVE_PRESEED_TIME=$((10#$TIME_NUMBER * 60))
                ;;
              *h)
                TIME_NUMBER=${RAW_TIME%h}
                [[ "$TIME_NUMBER" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: invalid time budget: $RAW_TIME" >&2; exit 2; }
                export SOLVE_PRESEED_TIME=$((10#$TIME_NUMBER * 3600))
                ;;
              *)
                [[ "$RAW_TIME" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: invalid time budget: $RAW_TIME" >&2; exit 2; }
                export SOLVE_PRESEED_TIME="$RAW_TIME"
                ;;
            esac
            ;;
          spend=*|tokens=*)
            RAW_SPEND=${1#*=}
            RAW_SPEND=${RAW_SPEND#\$}
            case "$RAW_SPEND" in
              unlimited|null) export SOLVE_PRESEED_SPEND=null ;;
              *)
                [[ "$RAW_SPEND" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "ERROR: invalid external spend budget: $RAW_SPEND" >&2; exit 2; }
                export SOLVE_PRESEED_SPEND="$RAW_SPEND"
                ;;
            esac
            ;;
        esac
        shift
      done
      ;;
    --)
      shift
      PRESEED_ARGS+=("$@")
      break
      ;;
    *)
      PRESEED_ARGS+=("$1")
      shift
      ;;
  esac
done

# Keep the old variable for state files created before the Codex port. It now
# means external research/API spend, not Codex subscription or model tokens.
if [ -n "${SOLVE_PRESEED_SPEND+x}" ]; then
  export SOLVE_PRESEED_TOKENS="$SOLVE_PRESEED_SPEND"
fi

PROMPT='$solve'
if [ ${#PRESEED_ARGS[@]} -gt 0 ]; then
  printf -v PROBLEM_TEXT '%s ' "${PRESEED_ARGS[@]}"
  PROBLEM_TEXT=${PROBLEM_TEXT% }
  PROMPT="$PROMPT $PROBLEM_TEXT"
fi

exec "$CODEX_BIN" "$PROMPT"
