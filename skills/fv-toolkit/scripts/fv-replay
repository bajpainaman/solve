#!/usr/bin/env python3
"""Turn a TLC counterexample into a pytest file that replays it against the code.

Usage: fv-replay <Spec.tla> <Config.cfg> [-o <test_file.py>]

The config must produce a violation. The script runs it through fv-tlc, takes
the counterexample, and writes a test that drives the real code through the
same steps and checks the property after each one. Without -o, the test is
printed.

The test needs a `driver` fixture, which you write once in conftest.py:

  reset(state)                   put the code into the model's initial state
  step(action, changed, state)   run the code step that this model action stands for
  check()                        assert the property on the code's own state

`action` is the name of the TLA+ action. `changed` holds the new value of each
variable that the step changed, and for a function or a record only the keys
that changed, so the key tells the driver which process moved. `state` is the
full model state after the step.

A replay that fails on the code reproduces the counterexample. A replay that
passes means the code does not follow the model here, so suspect the model
first, then the driver.

Exit codes: 0 when the test was written, 1 when the config has no
counterexample or TLC could not check it, 2 on a usage error, 3 when Java or
the TLC jar is missing.
"""
import json
import pprint
import re
import subprocess
import sys
from pathlib import Path

TEMPLATE = '''"""Replays the counterexample of {config} against the code.

Generated by fv-replay from {spec} and {config}. Regenerate this file; do not edit it.
The model's outcome was: {outcome}.
"""

TRACE = {trace}


def test_{name}_counterexample(driver):
    driver.reset(TRACE[0]["state"])
    for step in TRACE[1:]:
        driver.step(step["action"], step["changed"], step["state"])
        driver.check()
'''


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    out = None
    if "-o" in argv:
        index = argv.index("-o")
        if index + 1 >= len(argv):
            print("usage: fv-replay <Spec.tla> <Config.cfg> [-o <test_file.py>]", file=sys.stderr)
            return 2
        out, argv = argv[index + 1], argv[:index] + argv[index + 2:]
    if len(argv) != 2:
        print("usage: fv-replay <Spec.tla> <Config.cfg> [-o <test_file.py>]", file=sys.stderr)
        return 2
    spec, config = Path(argv[0]), Path(argv[1])

    run = subprocess.run(
        [str(Path(__file__).resolve().parent / "fv-tlc"), "--json", str(spec), str(config)],
        capture_output=True, text=True,
    )
    if run.returncode in (2, 3):
        print((run.stdout + run.stderr).strip())
        return run.returncode
    result = json.loads(run.stdout)[0]
    if not result["trace"]:
        print(f"FAIL {config.name}: no counterexample to replay; the outcome was {result['outcome'] or 'an error'}")
        return 1

    trace = [{"action": step["action"], "changed": step["changed"], "state": step["state"]} for step in result["trace"]]
    text = TEMPLATE.format(
        spec=spec.name, config=config.name, outcome=result["outcome"],
        trace=pprint.pformat(trace, width=100, sort_dicts=False),
        name=re.sub(r"\W+", "_", config.stem).strip("_").lower(),
    )
    if out in (None, "-"):
        print(text, end="")
    else:
        Path(out).write_text(text)
        print(f"WROTE {out} ({len(trace)} states)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
