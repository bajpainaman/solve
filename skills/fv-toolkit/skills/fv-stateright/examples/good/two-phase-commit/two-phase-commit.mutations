# Planted bugs for the centralized design. Each one must make rms_agree
# fail for Centralized; CARGO_TARGET_DIR keeps the build outside the copy
# fv-mutate makes, so the copy stays small and the build is reused.
run export CARGO_TARGET_DIR="${FV_HOME:-$HOME/.cache/fv}/stateright/target/two-phase-commit"; cargo test --quiet --lib
properties rms_agree_centralized
