#!/usr/bin/env bash
# $solve — Codex installer
#
# Remote:
#   bash <(curl -fsSL https://raw.githubusercontent.com/bajpainaman/solve/main/install)
# Local:
#   ./install
#
# Installs the skill at ~/.agents/skills/solve and the `solve` launcher at
# ~/.local/bin/solve. Codex subagents are enabled by default in current releases;
# this installer verifies that capability and never edits Claude configuration.

set -euo pipefail

if [ -t 1 ]; then
  C_BOLD=$(printf '\033[1m'); C_GREEN=$(printf '\033[32m')
  C_YELLOW=$(printf '\033[33m'); C_RED=$(printf '\033[31m')
  C_DIM=$(printf '\033[2m'); C_RESET=$(printf '\033[0m')
else
  C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_DIM=""; C_RESET=""
fi
log()  { printf '%s\n' "$*"; }
ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
fail() { printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
step() { printf '\n%s== %s ==%s\n' "$C_BOLD" "$*" "$C_RESET"; }

REPO_URL="${SOLVE_REPO_URL:-https://github.com/bajpainaman/solve.git}"
REPO_BRANCH="${SOLVE_REPO_BRANCH:-main}"
LOCAL_CACHE="${SOLVE_LOCAL_CACHE:-$HOME/.local/share/solve}"
DEST="${SOLVE_SKILL_DEST:-$HOME/.agents/skills/solve}"
SHIM_DIR="${SOLVE_SHIM_DIR:-$HOME/.local/bin}"
SHIM="$SHIM_DIR/solve"
CODEX_BIN="${CODEX_BIN:-codex}"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
SRC=""
if [ -f "$SCRIPT_DIR/SKILL.md" ]; then
  SRC="$SCRIPT_DIR"
elif [ -f "$SCRIPT_DIR/.agents/skills/solve/SKILL.md" ]; then
  SRC="$SCRIPT_DIR/.agents/skills/solve"
fi

# In curl/process-substitution mode the script has no sibling files. Maintain a
# stable local clone, preserving a failed cache as a timestamped backup.
if [ -z "$SRC" ]; then
  step '$solve installer (remote clone mode)'
  if ! command -v git >/dev/null 2>&1; then
    fail "git not found; clone manually: git clone $REPO_URL && cd solve && ./install"
    exit 1
  fi
  mkdir -p "$(dirname "$LOCAL_CACHE")"
  if [ -d "$LOCAL_CACHE/.git" ]; then
    log "Updating cache at $LOCAL_CACHE..."
    if ! git -C "$LOCAL_CACHE" pull --ff-only origin "$REPO_BRANCH"; then
      CACHE_BACKUP="$LOCAL_CACHE.bak.$(date +%Y%m%d-%H%M%S)"
      warn "cache update failed; preserving it at $CACHE_BACKUP"
      mv -- "$LOCAL_CACHE" "$CACHE_BACKUP"
    fi
  elif [ -e "$LOCAL_CACHE" ]; then
    CACHE_BACKUP="$LOCAL_CACHE.bak.$(date +%Y%m%d-%H%M%S)"
    warn "non-git cache exists; preserving it at $CACHE_BACKUP"
    mv -- "$LOCAL_CACHE" "$CACHE_BACKUP"
  fi
  if [ ! -d "$LOCAL_CACHE/.git" ]; then
    git clone --depth 1 --branch "$REPO_BRANCH" "$REPO_URL" "$LOCAL_CACHE"
  fi
  [ -f "$LOCAL_CACHE/SKILL.md" ] || { fail "cloned repository has no SKILL.md"; exit 1; }
  ok "source cached at $LOCAL_CACHE"
  exec bash "$LOCAL_CACHE/install" "$@"
fi

step '$solve installer for Codex'
log "Source: $SRC"
log "Skill:  $DEST"
log "Shim:   $SHIM"

step "1/6 dependency checks"
if ! command -v "$CODEX_BIN" >/dev/null 2>&1; then
  fail "Codex CLI not on PATH (https://developers.openai.com/codex/cli)"
  exit 1
fi
ok "$("$CODEX_BIN" --version 2>/dev/null | head -1)"

if ! command -v python3 >/dev/null 2>&1; then
  fail "python3 is required by solve's state and report helpers"
  exit 1
fi
ok "python3 found"

FEATURES=$("$CODEX_BIN" features list 2>/dev/null || true)
if printf '%s\n' "$FEATURES" | awk '$1 == "multi_agent" && $NF == "true" { found=1 } END { exit !found }'; then
  ok "Codex subagent workflows enabled"
elif printf '%s\n' "$FEATURES" | grep -q '^multi_agent[[:space:]]'; then
  fail "Codex multi_agent is disabled; enable it with: codex features enable multi_agent"
  exit 1
else
  fail "this Codex build does not expose multi-agent support; update Codex and retry"
  exit 1
fi

CODEX_CONFIG="${CODEX_HOME:-$HOME/.codex}/config.toml"
if [ -f "$CODEX_CONFIG" ]; then
  AGENTS_ENABLED=$(python3 - "$CODEX_CONFIG" <<'PY'
import sys

try:
    import tomllib
except Exception:
    tomllib = None

if tomllib is not None:
    try:
        with open(sys.argv[1], "rb") as handle:
            data = tomllib.load(handle)
        print("true" if data.get("agents", {}).get("enabled", True) else "false")
    except Exception:
        print("unknown")
else:
    # Python < 3.11 fallback for the single setting we need to detect.
    section = ""
    result = "unknown"
    with open(sys.argv[1]) as handle:
        for raw in handle:
            line = raw.split("#", 1)[0].strip()
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip()
            elif section == "agents" and line.startswith("enabled") and "=" in line:
                value = line.split("=", 1)[1].strip().lower()
                result = "false" if value == "false" else "true" if value == "true" else "unknown"
                break
    print(result)
PY
)
  if [ "$AGENTS_ENABLED" = "false" ]; then
    fail "agents.enabled=false in $CODEX_CONFIG; enable subagents before installing solve"
    exit 1
  fi
fi

GSTACK_ROOT="$HOME/.agents/skills/gstack"
if [ -d "$GSTACK_ROOT" ]; then
  ok "optional gstack integration found"
else
  warn "gstack not found at $GSTACK_ROOT; solve will run without its optional telemetry/browser helpers"
fi

step "2/6 install Codex skill"
mkdir -p "$(dirname "$DEST")"
SRC_REAL=$(cd "$SRC" && pwd -P)
DEST_REAL=$(python3 - "$DEST" <<'PY'
import sys
from pathlib import Path

print(Path(sys.argv[1]).expanduser().resolve())
PY
)
if [ -L "$DEST" ] && [ "$DEST_REAL" = "$SRC_REAL" ]; then
  ok "already symlinked correctly"
elif [ -e "$DEST" ] || [ -L "$DEST" ]; then
  if [ -d "$DEST" ] && [ "$(cd "$DEST" 2>/dev/null && pwd -P)" = "$SRC_REAL" ]; then
    ok "running from the installed skill directory"
  else
    BACKUP="$DEST.bak.$(date +%Y%m%d-%H%M%S)"
    mv -- "$DEST" "$BACKUP"
    warn "moved existing skill to $BACKUP"
  fi
fi

if [ ! -e "$DEST" ]; then
  if [ "${SOLVE_INSTALL_MODE:-symlink}" = "copy" ]; then
    cp -R "$SRC" "$DEST"
    ok "copied skill to $DEST"
  else
    ln -s "$SRC_REAL" "$DEST"
    ok "symlinked $DEST -> $SRC_REAL"
  fi
fi
chmod +x "$DEST"/bin/* 2>/dev/null || true

step "3/6 install solve launcher"
mkdir -p "$SHIM_DIR"
if [ ! -f "$SRC/solve" ]; then
  fail "$SRC/solve not found"
  exit 1
fi
if [ -e "$SHIM" ] || [ -L "$SHIM" ]; then
  if cmp -s "$SRC/solve" "$SHIM"; then
    ok "$SHIM already current"
  else
    SHIM_BACKUP="$SHIM.bak.$(date +%Y%m%d-%H%M%S)"
    mv -- "$SHIM" "$SHIM_BACKUP"
    warn "preserved existing launcher at $SHIM_BACKUP"
  fi
fi
if [ ! -e "$SHIM" ] && [ ! -L "$SHIM" ]; then
  cp "$SRC/solve" "$SHIM"
fi
chmod +x "$SHIM"
ok "$SHIM"

NEED_PATH=1
case ":$PATH:" in *":$SHIM_DIR:"*) NEED_PATH=0 ;; esac
if [ "$NEED_PATH" = "0" ]; then
  ok "$SHIM_DIR already on PATH"
else
  RC_TARGETS=()
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    [ -f "$rc" ] && RC_TARGETS+=("$rc")
  done
  for rc in "${RC_TARGETS[@]}"; do
    if grep -q '# solve-cli >>>' "$rc" 2>/dev/null; then
      ok "$rc already contains the solve PATH block"
      continue
    fi
    RC_BACKUP="$rc.solve-bak.$(date +%Y%m%d-%H%M%S)"
    cp -- "$rc" "$RC_BACKUP"
    {
      printf '\n# solve-cli >>>\n'
      printf 'export PATH="$HOME/.local/bin:$PATH"\n'
      printf '# solve-cli <<<\n'
    } >> "$rc"
    ok "added $SHIM_DIR to PATH in $rc (backup at $RC_BACKUP)"
  done
  if [ ${#RC_TARGETS[@]} -eq 0 ]; then
    warn "no shell rc file found; add $SHIM_DIR to PATH manually"
  else
    log "  ${C_DIM}open a new shell or source your shell rc before running solve${C_RESET}"
  fi
fi

step "4/6 optional Parallel.ai setup"
KEY_FILE="$HOME/.gstack/parallel-api-key"
mkdir -p "$HOME/.gstack"
if [ -n "${PARALLEL_API_KEY:-}" ] || [ -s "$KEY_FILE" ]; then
  ok "Parallel.ai key configured"
elif [ "${SOLVE_INSTALL_NONINTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
  warn "skipped in non-interactive install; run $DEST/bin/parallel-setup later if wanted"
else
  echo
  log "Parallel.ai is optional; Codex web search remains available without it."
  read -r -p "Set up a Parallel.ai key now? [y/N] " yn
  case "${yn:-N}" in
    y|Y|yes|YES) "$DEST/bin/parallel-setup" || warn "key setup skipped or failed" ;;
    *) warn "skipped" ;;
  esac
fi

step "5/6 validate skill package"
python3 - "$DEST/SKILL.md" <<'PY'
import re
import sys

text = open(sys.argv[1]).read()
match = re.match(r"^---\n(.*?)\n---", text, re.S)
if not match:
    raise SystemExit("invalid SKILL.md frontmatter")
frontmatter = match.group(1)
if not re.search(r"^name:\s*solve\s*$", frontmatter, re.M):
    raise SystemExit("SKILL.md name must be solve")
if not re.search(r"^description:\s*", frontmatter, re.M):
    raise SystemExit("SKILL.md description missing")
PY
ok "SKILL.md metadata valid"
if [ -f "$DEST/agents/openai.yaml" ]; then
  ok "agents/openai.yaml present"
else
  warn "agents/openai.yaml missing"
fi
if [ -f "$DEST/VERSION" ]; then
  ok "VERSION present"
else
  fail "VERSION missing"
  exit 1
fi

FRAMEWORK_COUNT=$(python3 - "$DEST/frameworks" <<'PY'
import sys
from pathlib import Path

print(sum(1 for path in Path(sys.argv[1]).glob("*.md") if path.name != "_TEMPLATE.md"))
PY
)
if [ "$FRAMEWORK_COUNT" = "25" ]; then
  ok "25 optional compact method cards"
else
  fail "framework count is $FRAMEWORK_COUNT (expected 25)"
  exit 1
fi
for required_file in gates/catalog.json lib/solve_contract.py lib/solve_output.py lib/solve_benchmark.py lib/solve_html.py lib/solve_prose.py lib/solve_templates.py lib/solve_bundle.py lib/solve_updates.py sources.json references/runtime.md references/roles.md references/confidence.md references/router.md references/output.md templates/catalog.json write/WRITE.md benchmarks/cases.jsonl; do
  if [ ! -f "$DEST/$required_file" ]; then
    fail "$required_file missing from adaptive verification package"
    exit 1
  fi
done
python3 - "$DEST" <<'PY'
import sys
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root / "lib"))
from solve_contract import catalog

gates = catalog()
assert {g["id"] for g in gates.values() if g["kind"] == "required"} == {"evidence", "refutation", "consumer"}
for gate in gates.values():
    assert (root / gate["method"]).is_file(), f"missing method: {gate['method']}"
PY
ok "adaptive gate catalog and validator load successfully"
for helper in parallel-research parallel-setup state-rw cost-track render-report budget-track calibration progress statusline tier gates benchmark templates prose-check html-sync check-updates; do
  if [ -x "$DEST/bin/$helper" ]; then
    ok "bin/$helper"
  else
    fail "bin/$helper missing or not executable"
    exit 1
  fi
done

if [ "${SOLVE_SKIP_HTML_SYNC:-0}" = "1" ]; then
  warn "html-sync skipped (SOLVE_SKIP_HTML_SYNC=1); run $DEST/bin/html-sync before make mode"
elif "$DEST/bin/html-sync"; then
  ok "built-in HTML mode ready at $DEST/html"
else
  warn "html-sync failed; make mode falls back to self-contained pages until $DEST/bin/html-sync succeeds"
fi

step "6/6 project routing check"
if [ -f "$PWD/AGENTS.md" ] && grep -q '\$solve\|Strategic decisions.*solve' "$PWD/AGENTS.md" 2>/dev/null; then
  ok "$PWD/AGENTS.md already routes to \$solve"
elif [ -f "$PWD/AGENTS.md" ]; then
  warn "$PWD/AGENTS.md exists but does not mention \$solve (left unchanged)"
fi

log
log "${C_BOLD}${C_GREEN}\$solve installed for Codex.${C_RESET}"
log
log "From any project:"
log "  solve \"<your problem>\""
log
log "Inside an existing Codex session:"
log "  \$solve \"<your problem>\""
log
log "If the skill does not appear immediately in /skills, restart Codex."
log
log "Manage:"
log "  solve --status"
log "  solve --update"
log "  solve --uninstall"
