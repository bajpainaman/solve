#!/usr/bin/env bash
# statusline — compact, host-neutral progress renderer for solve runs.
#
# Codex does not use Claude Code's JSON-command statusLine hook. This helper is
# retained for scripts and terminal integrations that want one compact line.
# It accepts either:
#   statusline [--run-dir DIR]
# or optional JSON on stdin containing {"cwd":"..."}.
#
# For an updating display, use: solve progress --watch

set -euo pipefail

RUN_DIR=""
if [ "${1:-}" = "--run-dir" ]; then
  [ $# -ge 2 ] || { echo "ERROR: --run-dir requires a directory" >&2; exit 2; }
  RUN_DIR="$2"
fi

INPUT=""
if [ -z "$RUN_DIR" ] && [ ! -t 0 ]; then
  INPUT=$(cat 2>/dev/null || true)
fi

WORKSPACE=""
if [ -n "$INPUT" ]; then
  WORKSPACE=$(printf '%s' "$INPUT" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
    print(data.get("cwd") or data.get("workspace", {}).get("cwd", ""))
except Exception:
    pass
' 2>/dev/null || true)
fi
[ -n "$WORKSPACE" ] || WORKSPACE=$(pwd)

if [ -z "$RUN_DIR" ]; then
  SOLVE_DIR="$WORKSPACE/.context/solve"
  [ -d "$SOLVE_DIR" ] || exit 0
  RUN_DIR=$(python3 - "$SOLVE_DIR" <<'PY' 2>/dev/null || true
import sys
from pathlib import Path

root = Path(sys.argv[1])
directories = [path for path in root.iterdir() if path.is_dir()]
if directories:
    print(max(directories, key=lambda path: path.stat().st_mtime_ns))
PY
)
fi
[ -n "$RUN_DIR" ] && [ -d "$RUN_DIR" ] || exit 0

# Ignore stale runs so shell prompts do not display old decisions forever.
NOW=$(date +%s)
STALE_TARGET="$RUN_DIR"
[ ! -f "$RUN_DIR/state.json" ] || STALE_TARGET="$RUN_DIR/state.json"
MTIME=$(python3 - "$STALE_TARGET" <<'PY'
import os
import sys
print(int(os.path.getmtime(sys.argv[1])))
PY
)
[ $((NOW - MTIME)) -le 21600 ] || exit 0

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
"$SCRIPT_DIR/progress" --run-dir "$RUN_DIR" --plain --no-color
